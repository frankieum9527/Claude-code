// Dev uses SQLite so the skeleton runs with zero infrastructure.
// Production target is Postgres — change provider to "postgresql" and re-migrate.
// SQLite has no native enums, so enum-like fields are strings; the allowed
// values are the string unions in @athlete-guide/shared-types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String  @id @default(uuid())
  authProviderId String? @unique // OIDC subject (Firebase UID); null for dev-stub users
  email          String  @unique
  name           String
  role           String // 'player' | 'coach' | 'parent'
  birthdate  DateTime?
  heightCm   Int?
  weightKg   Int?
  guardianId String? // guardian User.id for minors (consent flow lands in Phase 2)
  createdAt  DateTime @default(now())

  memberships TeamMembership[]
}

model Team {
  id          String   @id @default(uuid())
  name        String
  sport       String // 'hockey'
  joinCode    String   @unique
  icsUrl          String? // subscribed calendar feed (TeamSnap, SportsEngine, ...)
  icsGamesUrl     String? // optional games-only feed; makes game/practice split exact
  icsLastSyncedAt DateTime? // last background/manual sync attempt
  icsSyncStatus   String? // 'ok' | 'error' — feed health, shown to the coach
  icsSyncError    String? // message from the last failed sync, null when ok
  createdAt       DateTime  @default(now())

  memberships TeamMembership[]
  seasons     Season[]
}

model TeamMembership {
  id     String @id @default(uuid())
  userId String
  teamId String
  role   String // 'player' | 'coach'

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Season {
  id       String   @id @default(uuid())
  teamId   String
  name     String
  startsOn DateTime // inclusive, date-only semantics (midnight UTC)
  endsOn   DateTime // inclusive

  team   Team            @relation(fields: [teamId], references: [id])
  events ScheduleEvent[]
}

model ScheduleEvent {
  id         String   @id @default(uuid())
  seasonId   String
  type       String // 'practice' | 'game'
  title      String? // feed summary, e.g. "vs. Wildcats"
  startsAt   DateTime
  location   String?
  source     String   @default("manual") // 'manual' | 'ics' | platform ids later
  externalId String? // dedupe key for synced events (ICS UID)

  season Season @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, externalId])
  @@index([seasonId, startsAt])
}

model Drill {
  id          String  @id @default(uuid())
  sport       String
  title       String
  description String
  videoUrl    String?

  routineItems RoutineItem[]
}

model Routine {
  id    String @id @default(uuid())
  kind  String // 'practice_warmup' | 'game_warmup' | 'home_session'
  sport String
  title String

  items RoutineItem[]

  @@unique([sport, kind])
}

model RoutineItem {
  id          String @id @default(uuid())
  routineId   String
  drillId     String
  position    Int
  durationSec Int?

  routine Routine @relation(fields: [routineId], references: [id])
  drill   Drill   @relation(fields: [drillId], references: [id])

  @@unique([routineId, position])
}
