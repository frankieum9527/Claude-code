# SQLite for local development; production uses Postgres (swap the provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"
PORT=3000
# Background re-sync of connected calendar feeds; 0 disables the scheduler.
ICS_SYNC_INTERVAL_MINUTES=60
# AI feedback drafts for uploaded drill videos (coach reviews before players
# see anything). Set ANTHROPIC_API_KEY for real drafts (Claude vision over
# sampled video frames), or AI_FAKE=1 for deterministic dev drafts.
# FFMPEG_PATH overrides the ffmpeg binary used for frame sampling.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_FAKE=1
# FFMPEG_PATH=/usr/bin/ffmpeg

# OIDC auth. Setting AUTH_ISSUER requires Authorization: Bearer <ID token>
# on all endpoints, verified via the issuer's OIDC discovery + JWKS. Leave
# unset for the x-user-id dev stub.
# For Firebase Auth (recommended): issuer is securetoken.google.com/<project>,
# audience is the Firebase project id.
# AUTH_ISSUER=https://securetoken.google.com/your-project-id
# AUTH_AUDIENCE=your-project-id
