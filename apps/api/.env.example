# SQLite for local development; production uses Postgres (swap the provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"
PORT=3000
# Background re-sync of connected calendar feeds; 0 disables the scheduler.
ICS_SYNC_INTERVAL_MINUTES=60
# Clerk auth. Set to your Clerk frontend API URL (Dashboard → API keys →
# Frontend API, e.g. https://your-app.clerk.accounts.dev) to require
# Authorization: Bearer <session JWT> on all endpoints. Leave unset for the
# x-user-id dev stub. Optional: add email/name claims to the session token
# via a Clerk JWT template for auto-filled profiles on /auth/register.
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
