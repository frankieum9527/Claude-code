{
  "expo": {
    "name": "Athlete Guide",
    "slug": "athlete-guide",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Athlete Guide uploads your drill videos for coach review.",
          "cameraPermission": "Athlete Guide records drill videos for coach review."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    }
  }
}
